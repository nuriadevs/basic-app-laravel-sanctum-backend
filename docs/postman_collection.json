        {
          "name": "Login (admin)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text",
                "description": "Imprescindible en Laravel: sin esta cabecera, los errores de validacion o autenticacion devuelven HTML o redirigen en vez de JSON."
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "description": "Inicia sesion con el usuario **administrador** de la base de datos de prueba.\n\n**Auth:** no requiere token. **Guarda el token** automaticamente en `{{token}}`.\n\nCredenciales: `laura@example.com` / `Admin1234!`\n\nUsa esta peticion antes de probar las rutas que exigen rol admin (crear, editar o borrar productos, listar usuarios).\n\n**Respuestas:** `200` correcto, `401/422` credenciales incorrectas.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"laura@example.com\",\n  \"password\": \"Admin1234!\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Guarda el token automaticamente en la variable de coleccion {{token}}",
                  "// para que el resto de peticiones (Bearer) funcionen sin copiar y pegar.",
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "const token = json.token || (json.data && json.data.token) || json.access_token;",
                  "pm.test(\"La respuesta contiene un token\", () => pm.expect(token).to.be.a(\"string\").and.not.empty);",
                  "if (token) { pm.collectionVariables.set(\"token\", token); }"
                ]
              }
            }
          ],
          "response": [
            {
              "name": "200 OK",
              "originalRequest": {
                "method": "POST",
                "url": {
                  "raw": "{{baseUrl}}/auth/login",
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "path": [
                    "auth",
                    "login"
                  ]
                }
              },
              "status": "OK",
              "code": 200,
              "_postman_previewlanguage": "json",
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": "{\n  \"token\": \"1|abc123...\",\n  \"user\": {\n    \"id\": 1,\n    \"name\": \"Laura\",\n    \"email\": \"laura@example.com\",\n    \"role\": \"admin\"\n  }\n}"
            }
          ]
        },
        {
          "name": "Usuario autenticado",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text",
                "description": "Imprescindible en Laravel: sin esta cabecera, los errores de validacion o autenticacion devuelven HTML o redirigen en vez de JSON."
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/user",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "user"
              ]
            },
            "description": "Devuelve el usuario dueno del token actual.\n\n**Auth:** Bearer `{{token}}`.\n\n**Respuestas:** `200` correcto, `401` si falta el token o ha caducado.\n\n`email_verified_at` sera `null` hasta que se implemente la verificacion de email."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Devuelve un email\", () => pm.expect(pm.response.json().email || (pm.response.json().data||{}).email).to.be.a(\"string\"));",
                  "pm.test(\"email_verified_at es null (verificacion pendiente) o una fecha\", () => {",
                  "  const j = pm.response.json(); const u = j.data || j;",
                  "  if ('email_verified_at' in u) pm.expect(u.email_verified_at === null || typeof u.email_verified_at === 'string').to.be.true;",
                  "});"
                ]
              }
            }
          ],
          "response": []
        }
      ]
    },
    {
