      "item": [
        {
          "name": "Listar productos",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text",
                "description": "Imprescindible en Laravel: sin esta cabecera, los errores de validacion o autenticacion devuelven HTML o redirigen en vez de JSON."
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/products",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "products"
              ]
            },
            "description": "Lista todos los productos. Puede estar paginado segun tu controlador.\n\n**Auth:** Bearer `{{token}}` (o publica, segun tus rutas).\n\nLos datos de prueba incluyen 12 productos; el id 11 (Altavoz Bluetooth) tiene `stock = 0`, ideal para probar errores de stock insuficiente."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "const list = Array.isArray(json) ? json : (json.data || []);",
                  "pm.test(\"Devuelve una lista\", () => pm.expect(list).to.be.an(\"array\"));",
                  "if (list.length) { pm.collectionVariables.set('productId', list[0].id); }"
                ]
              }
            }
          ],
          "response": []
        },
